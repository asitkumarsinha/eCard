PORT=3000
JWT_SECRET=replace-with-a-long-random-production-secret
ADMIN_VERIFICATION_EMAIL=asitkumarsinha@gmail.com

# Set true only when a trusted reverse proxy (such as Nginx) supplies
# X-Forwarded-For. This records the real visitor IP in the admin log.
TRUST_PROXY=false

# SMTP is required for admin password-change codes and email sharing.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-user
SMTP_PASS=your-password
SMTP_FROM=eCard <no-reply@example.com>
